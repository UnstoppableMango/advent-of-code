{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"deny": [
			"WebFetch(domain:adventofcode.com)",
			"WebFetch(domain:www.adventofcode.com)",
			"Read(~/.adventofcode.session)",
			"Read(./src/**/input*)",
			"Read(./src/**/test.*)",
			"Bash(aoc submit:*)",
			"Bash(aoc read:*)",
			"Bash(nix fmt:*)",
			"Bash(treefmt:*)"
		]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit|NotebookEdit|Read|Grep|WebFetch|WebSearch|Bash",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.sh"
					}
				]
			}
		]
	}
}
